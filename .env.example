# 彼此_Autograder —— 混元大模型配置模板
# 用法：复制本文件为 .env.local，填入真实值后重启 `npm run dev`
# （.env.local 已被 .gitignore 忽略，不会提交到仓库；本模板可提交）

# 必填：腾讯混元 API Key（在腾讯云控制台「API Key 管理」或 TokenHub 创建）
HUNYUAN_API_KEY=

# 可选：Base URL。混元标准地址是 api.hunyuan.cloud.tencent.com/v1；
# 若用 TokenHub 平台，改成 https://tokenhub.tencentmaas.com/v1
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# 可选：模型名。混元用 hunyuan-turbos；TokenHub 用 hy4-preview（已关深度思考，约 20 秒/次）
HUNYUAN_MODEL=hunyuan-turbos

# 可选：评分超时毫秒数（默认 45000 = 45 秒；超时后自动降级本地规则评分）
LLM_TIMEOUT_MS=45000
